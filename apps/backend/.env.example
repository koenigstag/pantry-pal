# @pantry-pal/backend
# Copy to `.env.local` (git-ignored) and adjust. `.env.local` wins over `.env`.

NODE_ENV=development

# HTTP + WebSocket server bind address.
HOST=0.0.0.0
PORT=3001

# Comma-separated list of browser origins allowed to call the API and open a
# socket. Must include the frontend dev server origin.
CORS_ORIGIN=http://localhost:3000

# Express `trust proxy`. Behind a reverse proxy, name it (`loopback`, an address,
# or a hop count such as `1`), so the auth routes' rate limits see each client's
# address instead of the proxy's. Leave unset when clients connect directly.
# TRUST_PROXY=

# Database — the same variables `packages/db` uses for drizzle-kit and
# `pnpm db:seed`, resolved by the same `resolveConnectionString()`. Never commit
# a real host, port, credential or database name.
DATABASE_HOST=
DATABASE_PORT=
DATABASE_USER=
DATABASE_PASSWORD=
DATABASE_NAME=
# Set to `true` to require TLS.
# DATABASE_SSL=
# Alternative to the five variables above: one complete connection string.
# DATABASE_URL=
# Pool size; defaults to 10.
# DATABASE_POOL_MAX=

# Token signing keys (HS256), one per kind of token. Each at least 32 bytes, the
# two different, and both required under NODE_ENV=production. Generate each with:
# node -e "console.log(crypto.randomBytes(32).toString('base64url'))"
#
# Left empty in development, the process generates its own, which lasts until it
# restarts. For the access secret that only makes clients refresh; for the refresh
# secret it ends every session, so set that one to stay signed in across restarts.
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=

# Development sign-in: `POST /api/v1/auth/dev-sign-in` issues a session for any
# email, without a password, creating the account on first use. The backend
# refuses to start with it under NODE_ENV=production.
DEV_AUTH=true

# Enables `/api/v1/admin/*`, authenticated by the `x-admin-api-key` header.
# At least 16 characters. Leave empty to disable the admin API entirely.
# Generate one with: node -e "console.log(crypto.randomBytes(24).toString('base64url'))"
ADMIN_API_KEY=
