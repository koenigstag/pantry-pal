# @pantry-pal/db
# Copy to `.env.local` (git-ignored) and adjust.
#
# Used by drizzle-kit only. The library itself never reads the environment —
# `createDatabase(connectionString)` takes the URL as an argument, so the
# backend's ConfigService stays the single place configuration is resolved.

DATABASE_URL=postgres://pantry:pantry@localhost:5432/pantry_pal
