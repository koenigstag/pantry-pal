# Workspace-level defaults.
#
# Each package has its own .env.example with the variables it actually reads:
#   apps/backend/.env.example    HOST, PORT, CORS_ORIGIN, SEED_DEMO_DATA
#   apps/frontend/.env.example   PORT, BACKEND_PORT, VITE_BACKEND_URL
#   packages/shared/.env.example (build-time only)
#
# Copy any of them to `.env.local` in the same directory — `.env.local` is
# git-ignored, `.env.example` is committed.

NODE_ENV=development

# Turborepo
TURBO_TELEMETRY_DISABLED=1
# Set to enable remote caching (see `turbo login`).
# TURBO_TOKEN=
# TURBO_TEAM=
