# @pantry-pal/backend
# Copy to `.env.local` (git-ignored) and adjust. `.env.local` wins over `.env`.

NODE_ENV=development

# HTTP + WebSocket server bind address.
HOST=0.0.0.0
PORT=3001

# Comma-separated list of browser origins allowed to call the API and open a
# socket. Must include the frontend dev server origin.
CORS_ORIGIN=http://localhost:3000

# Database — the same variables `packages/db` uses for drizzle-kit and
# `pnpm db:seed`, resolved by the same `resolveConnectionString()`. Never commit
# a real host, port, credential or database name.
DATABASE_HOST=
DATABASE_PORT=
DATABASE_USER=
DATABASE_PASSWORD=
DATABASE_NAME=
# Set to `true` to require TLS.
# DATABASE_SSL=
# Alternative to the five variables above: one complete connection string.
# DATABASE_URL=
# Pool size; defaults to 10.
# DATABASE_POOL_MAX=

# Development identity: trust the `x-dev-user-email` header (and the socket
# handshake's `devUserEmail`) as the caller. A stand-in for real authentication;
# the backend refuses to start with it under NODE_ENV=production. Without it,
# every user route answers 401.
DEV_AUTH=true

# Enables `/api/v1/admin/*`, authenticated by the `x-admin-api-key` header.
# At least 16 characters. Leave empty to disable the admin API entirely.
# Generate one with: node -e "console.log(crypto.randomBytes(24).toString('base64url'))"
ADMIN_API_KEY=
