{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "printWidth": 100,
  "tabWidth": 2,
  "useTabs": false,
  "semi": true,
  "singleQuote": true,
  "jsxSingleQuote": false,
  "bracketSpacing": true,
  "insertFinalNewline": true,
  "sortImports": {},
  "sortPackageJson": {},
  "ignorePatterns": ["**/dist/**", "**/.turbo/**", "**/coverage/**", "pnpm-lock.yaml"]
}
