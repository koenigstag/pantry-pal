# @pantry-pal/shared
#
# This package is a compile-time library: it is bundled into the backend and the
# frontend and reads no environment variables of its own at runtime.
#
# Values that both apps must agree on (ports, API prefix, socket namespace, event
# names) live in `src/constants.ts` so they cannot drift between the two apps.
# Only add variables here if the shared build itself needs them.

# Emit sourcemaps + unminified output for the shared bundle (used by `tsup`).
NODE_ENV=development
