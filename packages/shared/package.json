{
  "name": "@pantry-pal/shared",
  "version": "0.0.0",
  "private": true,
  "description": "Constants, DTOs and utilities shared by the Pantry Pal backend and frontend.",
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": [
    "./dist/dto/index.js",
    "./dist/dto/index.cjs"
  ],
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./dto": {
      "import": {
        "types": "./dist/dto/index.d.ts",
        "default": "./dist/dto/index.js"
      },
      "require": {
        "types": "./dist/dto/index.d.cts",
        "default": "./dist/dto/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "type-check": "tsc --noEmit",
    "clean": "rimraf dist .turbo"
  },
  "dependencies": {
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "reflect-metadata": "^0.2.2"
  },
  "devDependencies": {
    "rimraf": "^6.0.1",
    "tsup": "^8.5.1",
    "typescript": "~6.0.3"
  },
  "engines": {
    "node": ">=24.21.0"
  }
}
