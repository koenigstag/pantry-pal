{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "outDir": "dist",
    "lib": ["ES2023"],
    "types": ["node"],
    // tsup@8 injects the deprecated `baseUrl` when generating declarations.
    "ignoreDeprecations": "6.0"
  },
  "include": ["src/**/*.ts", "tsup.config.ts", "drizzle.config.ts"],
  "exclude": ["node_modules", "dist"]
}
