# Normalise text to LF in the repository and on checkout, on every platform.
#
# oxfmt enforces `endOfLine: "lf"`. Without this, a Windows clone with
# core.autocrlf=true checks out CRLF, oxfmt rewrites every file, and
# `pnpm format:check` fails on an otherwise clean tree.
* text=auto eol=lf

# Generated: collapse in diffs and exclude from language stats.
pnpm-lock.yaml linguist-generated=true -diff

# Binary assets — never touch the bytes.
*.png  binary
*.jpg  binary
*.jpeg binary
*.gif  binary
*.webp binary
*.ico  binary
*.woff binary
*.woff2 binary
*.pdf  binary
